Package: xkcd
Type: Package
Title: Plotting 'ggplot2' Graphics in an 'XKCD' Style
Version: 0.1.1
Date: 2026-08-19
Authors@R: c(
    person(given = "Emilio", family = "Torres-Manzanera", role = "aut",
